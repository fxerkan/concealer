AUDITKEY = os.path.join(HOME, "keys", "audit.key")
AUDITLOG = os.path.join(HOME, "keys", "audit.log")
AUDITHEAD= os.path.join(HOME, "keys", "audit.head")   # son satir capasi (kuyruk-kirpma tespiti)
