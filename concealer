def _flag(a, name):
    if name in a: i = a.index(name); v = a[i + 1]; del a[i:i + 2]; return v
    return None
def _sel(a):
    sel = {}
    for fl, dim in FLAGS.items():
        v = _flag(a, fl)
        if v is not None: sel[dim] = v
    return sel
