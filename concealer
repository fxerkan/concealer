#!/usr/bin/env python3
"""concealer — lokal secret manager (SOPS+age uzerine ince sarmalayici).

Krypto sops+age ile. Bu dosya: tipli secret'lar (api_key/database/website/custom),
boyutlar (tenant/project/environment/repo) + tag + metadata (url/notes), tam CRUD,
HMAC-zincirli audit log, profesyonel web UI (SPA) ve MCP stdio sunucusu.

Depo (tek sifreli JSON, sops YAML olarak saklar):
  {"secrets":[ {"id","name","type","tenant","project","environment","repo",
                "tags":[],"url","notes","fields":{...},"created","updated"} ]}
Audit: keys/audit.log (JSONL, HMAC-zincirli, tamper-evident). Sadece anahtar
ISIMLERI ve eylemleri tutar, secret DEGERLERINI tutmaz.
"""
import os, sys, json, subprocess, secrets as _secrets, http.server, urllib.parse, html, getpass
import hashlib, hmac, shlex, re, csv, io, tempfile, base64, shutil
from datetime import datetime, timezone, timedelta

VERSION = "0.6.3"   # 0.x boyunca ilerler; 1.0 = tam canli/yayin surumu icin ayrilmistir
BASE = os.path.dirname(os.path.realpath(__file__))
def _default_home():
    # Depo checkout'u: vault script'in yaninda yasar → BASE'i koru (mevcut kurulumlar bozulmasin).
    # Brew/paket kurulumu (BASE salt-okunur) ya da temiz kurulum → kullanici-basi ~/.concealer.
    if os.path.exists(os.path.join(BASE, "keys")) or os.path.exists(os.path.join(BASE, "secrets.enc.yaml")):
        return BASE
    return os.path.expanduser("~/.concealer")
HOME = os.environ.get("CONCEALER_HOME", _default_home())
FILE = os.environ.get("CONCEALER_FILE", os.path.join(HOME, "secrets.enc.yaml"))
KEY  = os.environ.get("CONCEALER_KEY",  os.path.join(HOME, "keys", "age-key.txt"))
