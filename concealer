    c = _backup_cfg()
    if not c.get("enabled") or not c.get("pw_wrapped") or not c.get("dir"): return
    if c.get("last"):
        try:
            if datetime.now(timezone.utc) - datetime.fromisoformat(c["last"]) < timedelta(hours=c.get("interval_h", 24)):
                return
        except Exception: pass
