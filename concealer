_TUI_UTF8 = True   # curses UTF-8 kutu-cizim karakterleri emniyetli mi (locale'e gore, tui() ayarlar)

def tui():
    try: import curses, locale  # noqa: F401  (curses is Unix/macOS only)
    except ImportError: sys.exit("TUI needs the 'curses' module (Unix/macOS). Windows: pip install windows-curses.")
    # UTF-8 locale ZORLA: VS Code gibi terminaller C/ASCII locale ile acilir → ncurses
    # Unicode kutu-cizim karakterlerini (┌│─) sessizce dusurur. Once UTF-8 dene, olmazsa ASCII'ye don.
    global _TUI_UTF8; _TUI_UTF8 = False
    for loc in ("", "en_US.UTF-8", "C.UTF-8", "UTF-8", "en_US.utf8"):
        try: locale.setlocale(locale.LC_ALL, loc)
        except locale.Error: continue
        try: enc = locale.nl_langinfo(locale.CODESET) or ""
        except Exception: enc = ""
        if enc.upper().replace("-", "") == "UTF8": _TUI_UTF8 = True; break
    d = load()                       # TTY unlock (master pw prompt) happens here, before curses grabs the screen
    try:
        curses.wrapper(_tui_main, d)
    finally:
        # Guven duvari: curses zaten alternate-screen (?1049) kullaniyor, ama iTerm2'nin
        # "Save lines to scrollback in alternate screen mode" ayari acikken TUI kareleri
        # gercek scrollback'e kopyalaniyor → cikista secret'lar yukari kaydirinca gorunur
        # kaliyor. Terminal ayarina guvenmeyip cikista scrollback + ekrani BIZ siliyoruz.
        # \033[3J = scrollback sil (xterm/iTerm2), \033[2J = ekran, \033[H = imleci basa al.
        try:
            with open("/dev/tty", "w") as tty:
                tty.write("\033[H\033[2J\033[3J"); tty.flush()
        except Exception:
            sys.stdout.write("\033[H\033[2J\033[3J"); sys.stdout.flush()

def _tui_glyphs(u8):
    if u8:
        return {"tl": "┌", "tr": "┐", "bl": "└", "br": "┘", "h": "─", "v": "│",
                "lt": "├", "rt": "┤", "cur": "▸ ", "on": "◉ ", "off": "○ ", "ud": "↕"}
    return {"tl": "+", "tr": "+", "bl": "+", "br": "+", "h": "-", "v": "|",
            "lt": "+", "rt": "+", "cur": "> ", "on": "* ", "off": ". ", "ud": "^"}

def _tui_palette(curses):
    """Renk paleti — web 'Covert' temasi (amber accent). Barlar/secim icin
    A_REVERSE|amber kullanilir: temadan bagimsiz olarak amber zemin + koyu yazi
    verir (duz COLOR_BLACK bazi terminallerde amber uzerinde gorunmez kaliyordu)."""
    if curses.has_colors():
        curses.start_color(); curses.use_default_colors()
        amber = 214 if curses.COLORS >= 256 else curses.COLOR_YELLOW
        gray  = 245 if curses.COLORS >= 256 else curses.COLOR_WHITE
        curses.init_pair(1, amber, -1); curses.init_pair(2, gray, -1)
        curses.init_pair(3, curses.COLOR_GREEN, -1); curses.init_pair(4, curses.COLOR_RED, -1)
        curses.init_pair(5, curses.COLOR_CYAN, -1)
        curses.init_pair(6, gray, curses.COLOR_BLACK)   # modal icin OPAK siyah zemin
        acc, mut, ok, bad, typ = (curses.color_pair(i) for i in range(1, 6))
        fill = curses.color_pair(6)
    else:
        acc = curses.A_BOLD; mut = curses.A_DIM; ok = 0; bad = curses.A_BOLD; typ = 0; fill = 0
    return {"acc": acc, "mut": mut, "ok": ok, "bad": bad, "typ": typ, "fill": fill,
            "bar": acc | curses.A_REVERSE, "sel": acc | curses.A_REVERSE, "norm": 0}

