{
  "name": "concealer-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "concealer mobile app (iOS + Android) — offline vault open with the master password + bidirectional sync with the host.",
  "scripts": {
    "bundle:age": "esbuild age-encryption --bundle --format=esm --minify --outfile=www/age.js",
    "add:ios": "cap add ios",
