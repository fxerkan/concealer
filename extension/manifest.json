{
  "manifest_version": 3,
  "name": "concealer",
  "description": "Open the concealer vault and one-click copy secret values, without typing `cer web`.",
  "version": "0.9.17",
  "key": "",
  "action": {
    "default_popup": "popup.html",
    "default_title": "concealer"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ]
}
